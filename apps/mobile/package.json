{
  "name": "@ebenezer/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "prebuild": "expo prebuild --platform android --non-interactive",
    "apk": "bash scripts/build-apk.sh",
    "export:web": "expo export --platform web --output-dir dist-web",
    "apk:eas": "eas build --platform android --profile preview --non-interactive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ebenezer/shared": "workspace:*",
    "@ebenezer/tokens": "workspace:*",
    "@expo-google-fonts/hanken-grotesk": "^0.4.2",
    "@expo-google-fonts/literata": "^0.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.22",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.7",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.6",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "nativewind": "^4.1.23",
    "phosphor-react-native": "^3.0.6",
    "query-string": "^9.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.0.10",
    "eas-cli": "^24.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
