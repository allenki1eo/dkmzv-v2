# Local Turso / libSQL. Point DATABASE_URL at Turso Cloud when ready.
DATABASE_URL=file:./packages/db/local.db
DATABASE_AUTH_TOKEN=

# Session + OTP
AUTH_SECRET=change-me-in-production-use-32-bytes
OTP_DEV_CODE=255255

# Africa's Talking — leave empty to use the local OTP provider
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=EBENEZER

# Admin
NEXT_PUBLIC_APP_NAME=Ebenezer
NEXT_PUBLIC_DEFAULT_LOCALE=sw
